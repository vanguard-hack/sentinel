# Resolve from the public npm registry for this project.
#
# A machine-level ~/.npmrc pointing at a private mirror otherwise writes that
# mirror's hostname into package-lock.json on every install. This repo is
# public and CI has no credentials for a private registry, so those URLs break
# `npm ci` for every machine but the one that produced them. This line is
# scoped to this folder — it changes nothing global and nothing outside the
# repo.
registry=https://registry.npmjs.org/
