{
	"deployment": {
		"name": "rag",
		"stack": "node20",
		"type": "advancedio",
		"env_variables": {
			"RAG_CLIENT_ID": "<zoho-self-client-id>",
			"RAG_CLIENT_SECRET": "<zoho-self-client-secret>",
			"RAG_REFRESH_TOKEN": "<zoho-refresh-token — scripts/rotate-rag-token.sh renews this>",
			"RAG_ORG": "<catalyst-org-id>",
			"GROQ_API_KEY": "<groq-api-key>",
			"SUPPORT_EMAIL": "<help-center-recipient-email>",
			"SMTP_USER": "<gmail-address-for-sending>",
			"SMTP_PASS": "<gmail-app-password — Google Account > Security > App passwords>",
			"QUICKML_KEY_CHARGESHEET": "<quickml endpoint key — chargesheet-likelihood classifier>",
			"QUICKML_KEY_FIRVOLUME": "<quickml endpoint key — force-wide monthly volume pipeline>",
			"QUICKML_KEY_CRIMEHEAD": "<quickml endpoint key — monthly volume by crime head>",
			"QUICKML_KEY_DISTRICT": "<quickml endpoint key — monthly volume by district>"
		}
	},
	"execution": {
		"main": "index.js"
	}
}
