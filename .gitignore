# OS / editor noise
.DS_Store

# Dependencies & build output
node_modules/
frontend/build/
# `catalyst serve` stages the functions here (~19MB) — artifact, not source.
.build/

# Secrets — never commit. Real values live only locally and in the Catalyst console.
frontend/.env
functions/rag/catalyst-config.json

# Catalyst import job reports
Import_*.zip

# Synthetic dataset artifacts — regenerate with dataset/fir/generate_fir_dataset.py
dataset/*.csv
dataset/fir/*.csv
# Training tables — regenerate with dataset/ml/export_training_data.py
dataset/ml/*.csv
# ...except the section list. It is reference data, not bulk records (35 rows,
# 1 KB), and legal.test.js asserts the legal KB covers exactly these sections.
# A drift detector that cannot run in CI is decoration, so this one ships.
!dataset/fir/Section.csv
dataset/rag_docs/
dataset/import/configs_txt/

# Editor settings
.vscode/

# Catalyst CLI debug logs
catalyst-debug.log

# one-time geocode resume cache (regenerate with dataset/geocode_stations.py)
dataset/.geocode-cache.json

# join.test.js scratch db
dataset/.jointest.db

# Import parts: derived from the CSVs by prepare_import.py, regenerated on demand.
dataset/fir/parts/
dataset/.jointest.db
