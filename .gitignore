# OS / editor noise
.DS_Store

# Dependencies & build output
node_modules/
react-app/build/

# Secrets — never commit. Real values live only locally and in the Catalyst console.
react-app/.env
functions/rag/catalyst-config.json

# Catalyst import job reports
Import_*.zip

# Synthetic dataset artifacts — regenerate with ksp/fir/generate_fir_dataset.py
ksp/*.csv
ksp/fir/*.csv
# ...except the section list. It is reference data, not bulk records (35 rows,
# 1 KB), and legal.test.js asserts the legal KB covers exactly these sections.
# A drift detector that cannot run in CI is decoration, so this one ships.
!ksp/fir/Section.csv
ksp/rag_docs/
ksp/import/configs_txt/

# Editor settings
.vscode/

# Catalyst CLI debug logs
catalyst-debug.log

# one-time geocode resume cache (regenerate with ksp/geocode_stations.py)
ksp/.geocode-cache.json

# join.test.js scratch db
ksp/.jointest.db

# Import parts: derived from the CSVs by prepare_import.py, regenerated on demand.
ksp/fir/parts/
ksp/.jointest.db
